{
  "name": "lunadev-pos-central",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lunadev-pos-central",
      "database_id": "REEMPLAZAR_CON_ID_DE_TU_BASE_D1"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}